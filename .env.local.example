# Copy to .env.local (already gitignored) and fill in real values.
# These are the SAME Supabase project and Stripe account as website/ —
# see ../PRIVI_Backend_Schema_Reference.md. Do not create new instances.

# Supabase — Project Settings > API (same project as website/.env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — required for admin member/business management.
# Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Developers > API keys (same account as website/.env.local, test/sandbox pair)
# Server-only. Admin Portal reads subscription/payment state; it never takes
# payments or receives webhooks itself (that stays website's job).
STRIPE_SECRET_KEY=
# Price IDs (not Product IDs) for the two membership plans — same values as
# website/.env.local. Used to re-derive subscription_plan from a live Stripe
# subscription during resync.
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

# Google Maps Platform — Google Cloud Console, enable "Geocoding API" and
# "Maps JavaScript API" on the same project, then create two keys.
# Server-only, used for address lookup. Restrict to the Geocoding API only.
GOOGLE_MAPS_API_KEY=
# Browser-exposed, used to render the interactive map. Restrict by HTTP
# referrer (e.g. localhost:3000/* for dev) before shipping past dev.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
